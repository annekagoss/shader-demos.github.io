export default "#ifdef GL_ES\nprecision mediump float;\n#define GLSLIFY 1\n#endif\n\n#define TAU 6.2831853071\n\nuniform vec2 uResolution;\nuniform vec2 uMaxScale;\nuniform float uTime;\n\nconst float SPEED = .001;\n\nfloat SDFPentagon(vec2 _st, float radius, vec2 resolution) {\n  _st -= .5;\n  _st.y *= -1.;\n  _st.x *= resolution.x / resolution.y;\n  const vec3 k = vec3(.809016994, .587785252, .726542528);\n  _st.x = abs(_st.x);\n  _st -= 2. * min(dot(vec2(-k.x, k.y), _st), 0.) * vec2(-k.x, k.y);\n  _st -= 2. * min(dot(vec2(k.x, k.y), _st), 0.) * vec2(k.x, k.y);\n  _st -= vec2(clamp(_st.x, -radius * k.z, radius * k.z), radius);\n  return length(_st) * sign(_st.y);\n}\n\nmat2 matScale(vec2 scale) {\n    return mat2(scale.x, 0., 0., scale.y);\n}\n\nvec2 scale(vec2 _st, vec2 scale) {\n  _st -= vec2(.5);\n  _st = matScale(1. / scale) * _st;\n  _st += vec2(.5);\n  return _st;\n}\n\nvoid main() {\n  vec2 st = gl_FragCoord.xy / uResolution;\n  float sineScalar = sin(TAU + (uTime*SPEED)) * .5 + .5;\n  st = scale(st, uMaxScale * sineScalar);\n  float pentagon = abs(SDFPentagon(st, .25, uResolution))-.01;\n  float value = smoothstep(-.0025, .0025, -pentagon);\n  gl_FragColor = vec4(vec3(value), 1.);\n}"