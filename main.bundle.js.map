export default "#ifdef GL_ES\nprecision mediump float;\n#define GLSLIFY 1\n#endif\n\nuniform vec2 uResolution;\nuniform vec2 uRectDimensions;\n\nfloat rectangle(vec2 st, vec2 dimensions, vec2 resolution) {\n  float aspect = resolution.x / resolution.y;\n  st.x *= aspect;\n  dimensions.x /= aspect;\n  vec2 size = vec2(.5) - dimensions * .5;\n  size.x *= aspect;\n  vec2 origin = vec2(1.);\n  origin.x *= aspect;\n  vec2 uv = smoothstep(size, size + vec2(.005), st);\n  uv *= smoothstep(size, size+vec2(.005), origin - st);\n  return uv.x * uv.y;\n}\n\nvoid main(){\n  vec2 st = gl_FragCoord.xy / uResolution;\n  float value = rectangle(st, uRectDimensions, uResolution);\n  gl_FragColor = vec4(vec3(value), 1.);\n}\n"